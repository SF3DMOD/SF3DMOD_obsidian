		{"id":"c395dc16b08164ea","type":"text","text":"Actually, no","x":180,"y":-570,"width":200,"height":60},
		{"id":"ab6e67abb1c636ce","type":"text","text":"Blender is a Free and Open Source software for 3D modelling.\n**User manual:** https://docs.blender.org/manual/en/latest/","x":240,"y":-480,"width":500,"height":100},
		{"id":"149665c617aa59b2","type":"text","text":"Do concepts like Armature, Bone, Pose Mode, etc. - sound scary?","x":-45,"y":-320,"width":340,"height":100},
		{"id":"0cf58a0e9bbb2c18","type":"text","text":"No","x":180,"y":-150,"width":115,"height":60},
		{"id":"1c965fccec5b8907","type":"text","text":"Yes","x":-45,"y":-150,"width":115,"height":60},
